<!-- Stock keyboard has rectangular keys, and different color on abc/shift+more-keys/enter, this code changes colors and corner radius-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Action keys. (enter) -->
    <item android:state_active="true" android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
        android:shape="rectangle">
            <solid android:color="@color/key_background_pressed_lxx_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_active="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
        android:shape="rectangle">
            <solid android:color="@color/key_background_normal_lxx_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Toggle keys. Use checkable/checked state (shift) -->
    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true"
          android:drawable="@android:color/transparent" />
    <item android:state_checkable="true" android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
                <solid android:color="@color/key_background_pressed_lxx_light" />
                <corners android:radius="8dp" />
        </shape>
    </item>

    <item android:state_checkable="true" android:state_checked="true">
    <shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
            <solid android:color="@color/key_background_pressed_lxx_light" />
            <corners android:radius="8dp" />
       </shape>
    </item>
    <!-- (shift not pressed) -->
    <item android:state_checkable="true" android:state_checked="false">
    <shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
            <solid android:color="@color/key_background_normal_lxx_light" />
            <corners android:radius="8dp" />
       </shape>
    </item>

    <item android:state_checkable="true"
          android:drawable="@color/key_background_pressed_lxx_light" />

    <!-- Empty background keys. -->
    <item android:state_empty="true" android:state_pressed="true"
          android:drawable="@color/key_background_pressed_lxx_light" />

    <!-- Normal keys. -->
    <item android:state_pressed="true">
          <shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
            <solid android:color="@color/key_background_pressed_lxx_light" />
            <corners android:radius="8dp" />
       </shape>
    </item>

    <item android:state_pressed="false">
    <shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
            <solid android:color="@color/key_background_normal_lxx_light" />
            <corners android:radius="8dp" />
       </shape>
    </item>

</selector>
